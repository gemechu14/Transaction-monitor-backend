generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  displayName String?
  username    String?
  role        Role      @default(USER)
  status      Status    @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  DISABLED
}

/// Admin-edited details for one dashboard channel, keyed by its source id (e.g. "ips").
model ChannelInfo {
  source       String       @id
  description  String?
  /// Ordered list of { name, email }; at least one of the two per owner.
  owners       Json         @default("[]")
  /// null reads as "normal" (real-time).
  channelType  ChannelType?
  /// Months 1–12, sorted; only kept for seasonal channels. Empty is returned as null.
  activeMonths Int[]        @default([])
  updatedAt    DateTime     @updatedAt
  updatedBy    String?
}

enum ChannelType {
  normal
  nightly
  monthly
  yearly
  seasonal
}
